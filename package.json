{
  "name": "redcode",
  "private": true,
  "version": "1.0.0",
  "description": "Orquestracao local do RedCode",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "powershell -ExecutionPolicy Bypass -File ./setup-local.ps1 -AutoInstall -SkipRun",
    "setup:win": "powershell -ExecutionPolicy Bypass -File ./setup-local.ps1",
    "dev": "node scripts/dev-all.mjs",
    "dev:apps": "node scripts/dev-all.mjs --skip-db",
    "test": "dotnet test tests/RedCodeTests.csproj",
    "restore": "dotnet restore src/RedCodeApi/RedCodeApi.csproj && dotnet restore src/RedCodeFront/RedCodeFront.csproj && dotnet restore tests/RedCodeTests.csproj"
  }
}
